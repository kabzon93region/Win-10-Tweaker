[
  {
    "id": "CLN-01",
    "section": "cleaner",
    "titleKey": "tweak.CLN-01.title",
    "descriptionKey": "tweak.CLN.description",
    "risk": "high",
    "requiresReboot": false,
    "actions": [
      {
        "kind": "process_run",
        "program": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$s='[DllImport(\"psapi.dll\")]public static extern bool EmptyWorkingSet(IntPtr h);';$t=Add-Type -MemberDefinition $s -Name W -Namespace T -PassThru;Get-Process|Where-Object{$_.MainWindowHandle -eq 0 -and $_.Id -ne $PID}|ForEach-Object{[void]$t::EmptyWorkingSet($_.Handle)}"
        ]
      }
    ]
  },
