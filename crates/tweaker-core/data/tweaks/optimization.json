[
  {
    "id": "OPT-01",
    "section": "optimization",
    "titleKey": "tweak.OPT-01.title",
    "descriptionKey": "tweak.OPT.description",
    "risk": "high",
    "requiresReboot": false,
    "actions": [
      {
        "kind": "process_run_reversible",
        "program": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$dirs=@('C:\\Windows','C:\\Program Files','C:\\ProgramData');foreach($d in $dirs){compact /c /s:$d /a /i /exe:xpress4k /q | Out-Null}"
        ],
        "revert_program": "powershell.exe",
        "revert_args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "$dirs=@('C:\\Windows','C:\\Program Files','C:\\ProgramData');foreach($d in $dirs){compact /u /s:$d /a /i /q | Out-Null}"
        ]
      }
    ]
  },
  {
    "id": "OPT-02",
