                            "content":  "$path=$args[0]; $name=\u0027WinTweaker Block \u0027+(Split-Path -Leaf $path); netsh.exe advfirewall firewall delete rule name=\"$name\" dir=out | Out-Null; netsh.exe advfirewall firewall delete rule name=\"$name\" dir=in | Out-Null"
                        },
