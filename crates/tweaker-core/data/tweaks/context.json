                        {
                            "kind":  "file_write",
                            "path":  "C:\\Windows\\WinTweaker\\toggle-hidden.ps1",
                            "content":  "$k=\u0027HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\u0027; $v=(Get-ItemProperty -Path $k).Hidden; if ($v -eq 2) { Set-ItemProperty -Path $k -Name Hidden -Value 1; Set-ItemProperty -Path $k -Name ShowSuperHidden -Value 0 } else { Set-ItemProperty -Path $k -Name Hidden -Value 2; Set-ItemProperty -Path $k -Name ShowSuperHidden -Value 1 }"
                        },
                        {
                            "kind":  "registry_set",
                            "key":  {
                                        "root":  "hkcr",
                                        "path":  "DesktopBackground\\Shell\\WinTweakerHidden"
                                    },
                            "name":  "MUIVerb",
                            "value":  {
                                          "kind":  "string",
                                          "data":  "Показать/Скрыть системные папки"
                                      }
                        },
                        {
                            "kind":  "registry_set",
                            "key":  {
                                        "root":  "hkcr",
                                        "path":  "DesktopBackground\\Shell\\WinTweakerHidden\\command"
                                    },
                            "name":  "",
                            "value":  {
                                          "kind":  "string",
                                          "data":  "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"C:\\Windows\\WinTweaker\\toggle-hidden.ps1\""
                                      }
                        }
                    ]
    },
