                            "content":  "$path=$args[0]; $name=\u0027WinTweaker Block \u0027+(Split-Path -Leaf $path); netsh.exe advfirewall firewall add rule name=\"$name\" dir=out program=\"$path\" action=block | Out-Null; netsh.exe advfirewall firewall add rule name=\"$name\" dir=in program=\"$path\" action=block | Out-Null"
                        },
